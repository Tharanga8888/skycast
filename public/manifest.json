{
  "manifest_version": 3,
  "name": "Skycast – Weather",
  "version": "1.0.0",
  "description": "Current weather and a 5-day forecast for any city, one click away.",
  "action": {
    "default_popup": "index.html",
    "default_title": "Skycast",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "host_permissions": [
    "https://api.open-meteo.com/*",
    "https://geocoding-api.open-meteo.com/*"
  ]
}